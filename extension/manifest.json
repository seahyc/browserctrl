{
  "manifest_version": 3,
  "name": "cdp handoff",
  "version": "2.1.0",
  "description": "Hand tabs and page elements to a coding agent: annotate elements, mark tabs, record plays.",
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Hand tabs to the agent" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["annotate.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-annotate": {
      "suggested_key": { "default": "Alt+A", "mac": "Alt+A" },
      "description": "Toggle annotate mode on this page"
    },
    "mark-tab": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Hand this tab to the agent"
    }
  }
}
