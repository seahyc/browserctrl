{
  "name": "@seahyc/browserctrl",
  "version": "2.3.0",
  "type": "module",
  "description": "Browser control for agents: shared Chromium CDP and Safari MCP, with CLI and MCP frontends.",
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "chrome-devtools-protocol",
    "agent",
    "chromium",
    "safari",
    "cli"
  ],
  "bin": {
    "browserctrl": "bin/browserctrl.mjs",
    "browserctrl-vault": "bin/browserctrl-vault.mjs"
  },
  "scripts": {
    "pretest": "node test/sweep-orphans.mjs",
    "test": "node --import ./test/helpers.mjs --test --test-concurrency=1 --test-timeout=300000 test/*.test.mjs",
    "sync-extension": "node scripts/sync-extension.mjs",
    "prepack": "node scripts/sync-extension.mjs",
    "check-extension": "node scripts/sync-extension.mjs --check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seahyc/browserctrl.git"
  },
  "homepage": "https://github.com/seahyc/browserctrl",
  "bugs": {
    "url": "https://github.com/seahyc/browserctrl/issues"
  },
  "files": [
    "bin",
    "lib",
    "extension",
    "vendor",
    "references",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
