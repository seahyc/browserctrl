{
  "name": "browserctrl",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Browser control for agents: shared Chromium CDP and Safari MCP, with CLI and MCP frontends.",
  "bin": {
    "browserctrl": "bin/browserctrl.mjs",
    "cdp": "bin/cdp.mjs",
    "browserctl": "bin/cdp.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "sync-extension": "cp lib/overlay/annotate.js extension/annotate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seahyc/browserctrl.git"
  },
  "homepage": "https://github.com/seahyc/browserctrl",
  "bugs": {
    "url": "https://github.com/seahyc/browserctrl/issues"
  }
}
