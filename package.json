{
  "name": "browserctrl",
  "version": "2.3.0",
  "type": "module",
  "description": "Browser control for agents: shared Chromium CDP and Safari MCP, with CLI and MCP frontends.",
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "chrome-devtools-protocol",
    "mcp",
    "model-context-protocol",
    "agent",
    "chromium",
    "safari",
    "cli"
  ],
  "bin": {
    "browserctrl": "bin/browserctrl.mjs",
    "browserctrl-mcp": "mcp/server.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "sync-extension": "node scripts/sync-extension.mjs",
    "prepack": "node scripts/sync-extension.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
