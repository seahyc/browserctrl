[
  {
    "id": "chrome-cdp-skill-stars",
    "url": "https://github.com/pasky/chrome-cdp-skill",
    "step": "extract \"the number of stars\" as number as $value",
    "expect": {
      "selector": "span[class*=\"socialStat\"]:has(svg.octicon-star) strong",
      "capture": "([\\d,.]+\\s*[kKmM]?)",
      "number": true
    }
  },
  {
    "id": "chrome-cdp-skill-forks",
    "url": "https://github.com/pasky/chrome-cdp-skill",
    "step": "extract \"the number of forks\" as number as $value",
    "expect": {
      "selector": "a[href=\"/pasky/chrome-cdp-skill/forks\"]",
      "capture": "([\\d,.]+\\s*[kKmM]?)",
      "number": true
    }
  },
  {
    "id": "chrome-cdp-skill-language",
    "url": "https://github.com/pasky/chrome-cdp-skill",
    "step": "extract \"the primary language\" as $value",
    "expect": {
      "selector": "ul[class*=\"languageList\"] [itemprop=\"keywords\"]",
      "capture": "^([^\\d\\n]+)",
      "kind": "language"
    }
  },
  {
    "id": "chrome-cdp-skill-license",
    "url": "https://github.com/pasky/chrome-cdp-skill",
    "step": "extract \"the repository license\"",
    "expect": {
      "regex": "^(?:MIT(?: license)?|License: MIT)$"
    }
  },
