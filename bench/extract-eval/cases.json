  {
    "id": "playwright-release",
    "url": "https://github.com/microsoft/playwright",
    "step": "extract \"the latest release tag\" as $value",
    "expect": {
      "selector": "a[href*=\"/releases/tag/\"]",
      "capture": "^(v?[\\d]+\\.[\\d]+\\.[\\d]+(?:-[\\w.]+)?)",
      "kind": "release"
    }
  },
  {
    "id": "node-release",
    "url": "https://github.com/nodejs/node",
    "step": "extract \"the latest release tag\" as $value",
    "expect": {
      "selector": "a[href*=\"/releases/tag/\"]",
      "capture": "/releases/tag/(v[\\d]+\\.[\\d]+\\.[\\d]+)$",
      "kind": "release",
      "attribute": "href"
    }
  },
  {
    "id": "france-capital",
    "url": "https://en.wikipedia.org/wiki/France",
    "step": "extract \"the capital city\"",
    "expect": {
      "regex": "^(?:(?:Capital(?: and largest city)?[: ]*)?Paris(?:\\s*\\[[\\d]+\\])?|Its capital, largest city and main cultural and economic centre is Paris, with a metropolitan population of over 13 million\\.)$"
    }
  },
  {
    "id": "singapore-population",
    "url": "https://en.wikipedia.org/wiki/Singapore",
    "step": "extract \"the total population in the infobox\" as number as $value",
    "expect": {
      "selector": ".infobox",
      "capture": "Population[\\s\\S]*?([\\d,]{7,})",
      "number": true
    }
  },
  {
    "id": "singapore-independence",
    "url": "https://en.wikipedia.org/wiki/Singapore",
    "step": "extract \"the independence date from Malaysia\" as date as $value",
    "expect": {
      "exact": "1965-08-09"
    }
  },
  {
    "id": "singapore-founded",
    "url": "https://en.wikipedia.org/wiki/Singapore",
    "step": "extract \"the founding date of the British settlement of Singapore\" as date as $value",
    "expect": {
      "exact": "1819-02-06"
    }
  },
  {
    "id": "python-version",
    "url": "https://www.python.org/downloads/",
    "step": "extract \"the latest Python version\" as $value",
    "expect": {
      "selector": "a[href*=\"/ftp/python/\"][href$=\".tar.xz\"]",
      "capture": "(Python [\\d]+\\.[\\d]+\\.[\\d]+)",
      "kind": "python"
    }
  },
  {
    "id": "npm-version",
    "url": "https://www.npmjs.com/package/lodash",
    "step": "extract \"the current lodash version\" as $value",
    "expect": {
      "selector": "body",
      "capture": "Version\\s*([\\d]+\\.[\\d]+\\.[\\d]+)"
    }
  },
  {
    "id": "npm-downloads",
    "url": "https://www.npmjs.com/package/lodash",
    "step": "extract \"weekly downloads\" as number as $value",
    "expect": {
      "selector": "body",
      "capture": "Weekly Downloads\\s*([\\d,]+)",
      "number": true
    }
  },
  {
    "id": "github-free-price",
    "url": "https://github.com/pricing",
    "step": "extract \"the monthly per user price of the Free plan\" as number as $value",
    "expect": {
      "exact": 0
    }
  },
  {
