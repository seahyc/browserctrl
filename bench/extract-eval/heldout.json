  {
    "id": "is-relative-stars",
    "url": "https://github.com/sindresorhus/is-relative",
    "family": "stars",
    "step": "extract \"the number of stars\" as number as $value",
    "expect": {
      "selector": "span[class*=\"socialStat\"]:has(svg.octicon-star) strong",
      "capture": "([\\d,.]+\\s*[kKmM]?)",
      "number": true
    }
  },
