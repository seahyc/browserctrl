{
  // Type-checks the JavaScript as written (no build step): `npm run typecheck`.
  // Modules join the list as their shared shapes get JSDoc types.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "files": ["lib/types.d.ts", "lib/config.mjs", "lib/commit.mjs", "lib/judge.mjs"]
}
